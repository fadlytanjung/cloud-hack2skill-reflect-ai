rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Administrator status is predefined data: users/{uid}.role == 'admin',
    // seeded out of band with scripts/set-user-role.sh. Clients can never write
    // that field (see the /users rules below), so this helper is trustworthy.
    function isAdmin() {
      return request.auth != null &&
             (request.auth.token.admin == true ||
              (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    // True when the incoming write leaves the `role` field exactly as it is.
    function roleUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
    }

    // Journal entries are owner-bound.
    match /users/{userId}/interactions/{interactionId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // A user may create their own profile, but may not assign a role while
      // doing so — otherwise anyone could sign up as an administrator.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && !request.resource.data.keys().hasAny(['role']);

      // A user may keep their own profile up to date as long as `role` is
      // untouched. This is the rule that closes self-escalation: the field the
      // isAdmin() helper reads cannot be written by the account it governs.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && roleUnchanged();

      // Roles are granted only through the Admin SDK or the Firestore REST API
      // with a service-account credential, both of which bypass these rules.
      allow delete: if false;
    }

    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
