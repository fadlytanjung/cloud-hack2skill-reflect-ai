# Dependencies
node_modules/
.pnp
.pnp.js

# Bun is the only package manager; bun.lock is the only committed lockfile.
# A second lockfile means the container and a laptop can resolve different
# versions, and it is what broke the Cloud Build `npm ci` step.
package-lock.json
yarn.lock
pnpm-lock.yaml

# Production build output
dist/
build/
coverage/

# Environment and secrets (NEVER commit credentials)
.env
.env.*
!.env.example
*.env.local
*.pem
*.key
*.cert
*.crt
serviceAccountKey*.json
*credentials*.json
*secret*.json

# Firebase local configurations containing API keys & debug logs
firebase-applet-config.json
firebase-applet-config*.json
firebase-debug.log*
.firebase/

# Agent tooling
# Antigravity is the committed agent surface: .agents/rules, .agents/skills and
# AGENTS.md are shared with the team. Claude Code's .claude/ is kept local so
# each contributor can use whichever assistant they prefer without the two
# configurations drifting apart. Skills live in .agents/skills/<name>/SKILL.md.
.claude/
.antigravity/
.agents/local/

# Python bytecode from scripts/
__pycache__/
*.py[cod]

# OS and IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
