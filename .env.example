# ==============================================================================
# ReflectAI Environment Variables & Google Cloud Secret Manager Template
# Secret Manager Secret Name: reflect-ai-env
# Database Name: reflect-ai-app
# ==============================================================================

# 1. CORE GEMINI AI ENGINE
# Sourced at runtime from Google Cloud Secret Manager (reflect-ai-env) or container environment
GEMINI_API_KEY=""

# 2. GOOGLE CLOUD PROJECT & RUNTIME IDENTIFIERS
GCP_PROJECT_ID="YOUR_GCP_PROJECT_ID"
APP_URL="https://YOUR_GCP_PROJECT_ID.web.app"

# 3. EXTERNAL NOTIFICATIONS & DISCORD EGRESS
# Channel for outbound reflection alerts & synthesized takeaways
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_CHANNEL_ID/YOUR_TOKEN"

# 4. LOCATION-AWARE ENTRIES (GOOGLE MAPS PLATFORM)
# Restricted API key for geocoding & location-tagging
MAPS_API_KEY=""

# 5. FIREBASE CLIENT CONFIGURATION
# IMPORTANT: Explicitly name your Firebase Web API Key 'reflect-ai-app' in GCP Console.
# Do NOT use ambiguous names like 'Browser key (auto created by Firebase)'.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_PROJECT_ID="YOUR_GCP_PROJECT_ID"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_GCP_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_APP_ID="1:YOUR_PROJECT_NUMBER:web:YOUR_APP_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_GCP_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_PROJECT_NUMBER"
VITE_FIREBASE_DATABASE_ID="reflect-ai-app"
